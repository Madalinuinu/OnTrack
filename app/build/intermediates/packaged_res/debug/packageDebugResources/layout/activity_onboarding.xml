<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundal animat cu orbs plutitoare -->
    <com.example.ontrack.AnimatedBackgroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Guideline la 88% de sus = butonul va sta mereu la ~12% de la baza
        ecranului, proportional pe orice dimensiune de telefon.
    -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.82" />

    <!--
        Titlul este ancorat atat de top cat si de bottom, cu verticalBias=0.36.
        Asta inseamna ca va fi mereu la ~36% din inaltimea ecranului,
        indiferent de rezolutie (5" sau 6.7").
    -->
    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Hi, welcome"
        android:textColor="#FFFFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/gl_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.24" />

    <!-- Subtitlu imediat sub titlu -->
    <TextView
        android:id="@+id/welcome_subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:letterSpacing="0.03"
        android:text="to the app"
        android:textColor="#E8EDFF"
        android:textSize="21sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@id/welcome_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tagline sub subtitlu -->
    <TextView
        android:id="@+id/tagline_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingMultiplier="1.55"
        android:maxWidth="300dp"
        android:text="Create systems to build\nstrong habits"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/welcome_subtext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Campul de nume apare deasupra butonului dupa primul tap.
        Ancorat de buton, nu de un pozitie fixa.
    -->
    <EditText
        android:id="@+id/name_input"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/input_onboarding"
        android:hint="Enter your name"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#CCFFFFFF"
        android:inputType="textPersonName"
        android:visibility="gone"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/get_started_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.82" />

    <!--
        Butonul ancorat de guideline la 88%: mereu proportional pe orice ecran.
    -->
    <Button
        android:id="@+id/get_started_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="GET STARTED"
        android:textColor="@color/ob_button_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:background="@drawable/button_onboarding_white"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toTopOf="@id/gl_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.82" />

</androidx.constraintlayout.widget.ConstraintLayout>
